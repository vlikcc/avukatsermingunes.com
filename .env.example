# .env.example dosyasını .env olarak kopyalayıp doldurun. .env dosyasını paylaşmayın.

PORT=3000
# Canlı ortamda: production (HSTS ve güvenli çerez etkinleşir; HTTPS gerekir)
NODE_ENV=development

# Yönetim paneli (/yonetim) şifresi — uzun ve tahmin edilemez bir şifre seçin.
ADMIN_PASSWORD=
# Oturum imzası için rastgele uzun bir değer. Örnek üretim: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Site bir ters vekil sunucunun (nginx vb.) arkasındaysa true yapın.
TRUST_PROXY=false
# E-postalardaki bağlantılar için sitenin adresi (site.config.js içindeki siteUrl yoksa)
PUBLIC_URL=

# E-posta bildirimleri (boş bırakılırsa e-posta gönderilmez)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Yeni randevu ve mesaj bildirimlerinin gideceği adres
NOTIFY_EMAIL=

# Veritabanı klasörü (varsayılan: ./data)
# DATA_DIR=
